PORT=8787
JARVIS_API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGIN=https://your-jarvis-frontend.example
WPP_BRIDGE_URL=
WPP_BRIDGE_TOKEN=

# Google OAuth server-only values; never expose the client secret in frontend code
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact HTTPS callback registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/oauth/callback
# Generate long random values (at least 32 bytes); do not commit real values
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
