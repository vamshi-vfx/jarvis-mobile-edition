PORT=8787
JARVIS_API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGIN=https://your-jarvis-frontend.example
# Private JARVIS-specific bridge; never put these values in frontend code.
WPP_BRIDGE_URL=
WPP_BRIDGE_TOKEN=
# Exact self-chat JID/recipient accepted by your private bridge; automation never accepts a caller-supplied recipient.
WPP_SELF_CHAT_ID=
# Google OAuth server-only values; never expose the client secret in frontend code
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact HTTPS callback registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/oauth/callback
# Generate long random values (at least 32 bytes); do not commit real values
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Phase 2 billing scaffolding (server-only; leave blank; checkout remains disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Do not set this until production review, webhook verification, and explicit approval are complete
BILLING_ENABLED=false
